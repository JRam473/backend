{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend con Express, TypeScript y soporte para usuarios, fotos y comentarios",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "init-db": "node --loader ts-node/esm src/scripts/init-database.ts",
    "build-and-init": "npm run build && npm run init-db",
    "railway-build": "npm run build-and-init",
    "railway-start": "npm run start",
    "upload:images": "node --loader ts-node/esm src/scripts/subidorImagenesAvanzado.ts",
    "clean": "rm -rf dist node_modules",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google-cloud/dialogflow": "^7.4.0",
    "@google-cloud/vision": "^5.3.4",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.12.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.8.0",
    "concurrently": "^7.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-validator": "^7.3.0",
    "fs-extra": "^11.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-fetch": "^2.7.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdf-parse": "^1.1.4",
    "pdf2pic": "^3.2.0",
    "pg": "^8.16.3",
    "sharp": "^0.34.4",
    "tar": "^7.5.1",
    "tesseract.js": "^6.0.1",
    "tmp": "^0.2.5",
    "validator": "^13.15.20"
  },
  "devDependencies": {
    "@types/axios": "^0.9.36",
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-rate-limit": "^5.1.3",
    "@types/express-validator": "^2.20.33",
    "@types/fs-extra": "^11.0.4",
    "@types/helmet": "^0.0.48",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.9.0",
    "@types/node-fetch": "^2.6.13",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.15.5",
    "@types/tmp": "^0.2.6",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
