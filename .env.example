# ===========================================
# CONFIGURACIÓN BACKEND - PRODUCCIÓN (EJEMPLO)
# ===========================================

# JWT (EN PRODUCCIÓN GENERA UNO NUEVO Y SEGURO)
JWT_SECRET=<GENERAR_EN_RAILWAY>
JWT_EXPIRES_IN=60m

# Server
PORT=4000
NODE_ENV=production

# Database (Railway proporciona DATABASE_URL automáticamente)
# DATABASE_URL=<SE_AUTOGENERA_EN_RAILWAY>

# Google OAuth (SOLO PLACEHOLDERS)
GOOGLE_CLIENT_ID=<TU_GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET_<TU_GOOGLE_CLIENT_SECRET>
GOOGLE_CALLBACK_URL=<TU_URL_DE_PRODUCCION>/api/auth/google/callback

# Admin
ADMIN_EMAIL=<CORREO_ADMIN>

# Frontend (URL DE PRODUCCIÓN)
FRONTEND_URL=<URL_DE_TU_FRONTEND>

# Google Perspective API Key
PERSPECTIVE_API_KEY=<API_KEY_PERSPECTIVE>

# Servidor de modelos
MODEL_SERVER_URL=http://localhost:5000
MODEL_SERVER_TIMEOUT=30000

# Configuración de modelos
USE_GPU=false
MODEL_OPTIMIZATION=true

# Google Cloud Vision (SOLO PLACEHOLDERS)
GOOGLE_VISION_API_KEY=<GOOGLE_VISION_API_KEY>
GOOGLE_CLOUD_PROJECT=<GOOGLE_CLOUD_PROJECT_ID>

# Cloudinary
CLOUDINARY_CLOUD_NAME=<CLOUD_NAME>
CLOUDINARY_API_KEY=<CLOUDINARY_API_KEY>
CLOUDINARY_API_SECRET=<CLOUDINARY_API_SECRET>

# ===========================================
# VARIABLES QUE RAILWAY PROPORCIONA AUTOMÁTICAMENTE:
# - DATABASE_URL
# - RAILWAY_STATIC_URL
# - RAILWAY_GIT_COMMIT_SHA
# ===========================================
